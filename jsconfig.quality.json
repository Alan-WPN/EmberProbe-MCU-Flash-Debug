{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "skipLibCheck": true,
    "strict": false,
    "types": ["node"]
  },
  "include": ["src/**/*.js", "skills/**/*.js", "scripts/**/*.js", "test/hil/run-hil.js"],
  "exclude": ["src/webview/**/*.js"]
}
